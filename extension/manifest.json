{
  "manifest_version": 3,
  "name": "meal-planner shopping assistant",
  "version": "0.12.0",
  "description": "Side panel on Sainsbury's to link the week's shopping list to products, then add them all to your basket.",
  "action": { "default_popup": "popup.html" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.sainsburys.co.uk/groceries/*",
        "https://www.sainsburys.co.uk/gol-ui/*"
      ],
      "js": ["product.js"],
      "run_at": "document_idle"
    }
  ]
}
